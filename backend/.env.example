# Free-tier defaults. Everything works offline with the mock providers.
# LLM_PROVIDER: mock | gemini | openai_compat   (auto: gemini if GEMINI_API_KEY set, else mock)
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Any OpenAI-compatible endpoint (Groq free tier, OpenAI, Ollama, ...)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# IMAGE_PROVIDER: horde (free anonymous, slow queue) | pollinations (free tier is gated/flaky) | mock
IMAGE_PROVIDER=horde
AI_HORDE_API_KEY=
POLLINATIONS_API_KEY=
# TTS_PROVIDER: edge (free, no key) | mock
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AriaNeural

# Optional: path to a music bed mixed under narration
BGM_PATH=
# Optional: override ffmpeg binary (default: PATH, then bundled imageio-ffmpeg)
FFMPEG_PATH=
